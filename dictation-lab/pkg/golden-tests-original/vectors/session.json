   "id": "NAV-001",
   "title": "skip an item and return: its first attempt is still the first",
   "kind": "session",
   "requires": "oracle",
   "tags": [
    "adversarial"
   ],
   "input": {
    "mode": "free_practice",
    "version": "v1",
    "items": [
     "A",
     "B",
     "C"
    ],
    "events": [
     {
      "op": "goto",
      "item": "A"
     },
     {
      "op": "goto",
      "item": "C"
     },
     {
      "op": "check",
      "item": "C",
      "num": 6,
      "den": 6
     },
     {
      "op": "goto",
      "item": "B"
     },
     {
      "op": "check",
      "item": "B",
      "num": 3,
      "den": 6
     }
    ]
   },
   "expected": {
    "results": [
     "ok",
     "ok",
     "recorded",
     "ok",
     "recorded"
    ],
    "final": {
     "attemptCounts": {
      "A": 0,
      "B": 1,
      "C": 1
     },
     "firstAttempt": {
      "B": {
       "num": 3,
       "den": 6
      },
      "C": {
       "num": 6,
       "den": 6
      }
     }
    }
   }
  },
