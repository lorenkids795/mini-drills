+async function whoami(env, request) {
+  const who = await idUser(env, request);
+  if (!who) return needSignIn();
+  const r = await roleOf(env, who.em);
+  if (!r) return json({ role: '', adm: false, code: 'norole' });
+  return json({ role: r.role, adm: !!r.adm });
+}
