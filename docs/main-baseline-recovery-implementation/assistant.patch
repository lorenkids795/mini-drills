+  for (let i = 0; i < extIn.length; i++) {
+    const x = extIn[i] || {}, link = String(x.link || '').trim();
+    if (!/^https?:\/\/[^\s<>"']+$/i.test(link)) return fail('External task ' + (i + 1) + ': paste the full link, starting with https://');
