+    while (used[xid]) xid = 'x' + (Number(xid.slice(1)) + 1);
+    used[xid] = 1;
+    ext.push({ id: xid, link: link.slice(0, 500), src: String(x.src || '').trim().slice(0, 40), note: String(x.note || '').trim().slice(0, 600) });
