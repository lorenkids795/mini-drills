rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Logins come from the /api Worker, which signs a Firebase custom token with
    // claims: em = email, role = "student" | "teacher" | "assistant", adm = true only for the admin (ADMIN_EMAIL).
    // A tester is a student (role "student"; the tester flag is on its roster row).
    // A Homework Assistant ("assistant") gets NOTHING here: no read, no write. Everything it may see (its own classes only)
    // comes from the /api/hwa/* routes, which check the classes the admin gave on every call.
    // The server (service account) is not bound by these rules: Lucky Wheel, Kick / purge, seasons, AI, assistants.
    function signedIn() {
      return request.auth != null && request.auth.token.em is string && request.auth.token.get('role', '') != 'assistant';
    }
    function me() {
      return request.auth.token.em.lower();
    }
    function teacher() {
      return signedIn() && request.auth.token.role == 'teacher';
    }
    // (11/2026, D2) the admin = a teacher token that also carries adm == true. Site-wide settings, vouchers, accounts and
    // deleting learning data are admin only; ordinary teachers keep teaching work (Library, homework, marking, classes, level).
    function admin() {
      return teacher() && request.auth.token.get('adm', false) == true;
    }
    function ownsOld() {
      return signedIn() && resource.data.email == me();
    }
    function ownsNew() {
      return signedIn() && request.resource.data.email == me();
    }
    // the fields this write changes
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    // a number field of the new data that is missing or a whole/decimal number between lo and hi
    function numIn(k, lo, hi) {
      return !(k in request.resource.data)
        || (request.resource.data[k] is number && request.resource.data[k] >= lo && request.resource.data[k] <= hi);
    }
    // how much a number field went up in this write (missing = 0)
    function upBy(k) {
      return request.resource.data.get(k, 0) - resource.data.get(k, 0);
    }

    // ---- (11/2026) Mỗi lần giao bài có hạn riêng: [ngày gửi, hạn + late pass] ----
    // slug(email) giống app: chữ thường, ký tự khác a-z0-9 thành '-', bỏ '-' ở hai đầu (id của passes = slug_asgId)
    function mySlug() {
      return me().replace('[^a-z0-9]+', '-').replace('^-|-$', '');
    }
    function passDays(asg) {
      let path = /databases/$(database)/documents/passes/$(mySlug() + '_' + asg);
      let k = exists(path) ? get(path).data.get('kind', '') : '';
      return k == 'week' ? 7 : (k == 'day' ? 1 : 0);
    }
    // bài giao còn mở lúc này (giờ của server): đã gửi (cho lệch 10 phút) và chưa quá hạn + late pass của chính học sinh.
    // Bài giao kiểu cũ (chỉ có weekStart, không có due) không tính được hạn: không chặn.
    function asgOpen(asg) {
      let a = get(/databases/$(database)/documents/assignments/$(asg)).data;
      return !('due' in a)
        || (request.time.toMillis() >= a.get('start', 0) - 600000
            && request.time.toMillis() <= a.due + passDays(asg) * 86400000);
    }

    // ---- Bài làm: học sinh chỉ thấy bài của mình, giáo viên thấy tất cả ----
    match /attempts/{id} {
      allow read: if teacher() || ownsOld();
      // học sinh không được tự gắn điểm chấm (grade) hay kết quả AI (ai: chỉ server ghi); điểm tự chấm phải hợp lý
      allow create: if ownsNew()
        && !('grade' in request.resource.data) && !('ai' in request.resource.data)
        && numIn('score', 0, 1000) && numIn('total', 0, 1000)
        && numIn('answered', 0, 1000) && numIn('required', 0, 1000)
        && request.resource.data.get('answered', 0) <= request.resource.data.get('required', 1000)
        && request.resource.data.get('score', 0) <= request.resource.data.get('total', 0)
        // giờ nộp do server ghi (không sửa lùi được); bài làm cho một bài giao (asg) chỉ nhận khi bài giao đó còn mở
        && request.resource.data.sts == request.time
        && (request.resource.data.get('asg', '') == ''
            || (request.resource.data.asg is string && asgOpen(request.resource.data.asg)));
      // giáo viên chấm (grade, nhận xét Writing); học sinh chỉ thêm gợi ý sửa lỗi (fixes); admin mọi trường
      allow update: if admin()
        || (teacher() && changed().hasOnly(['grade', 'annotations', 'overallComment', 'fixes']))
        || (ownsOld() && changed().hasOnly(['fixes']));
      allow delete: if admin();
    }

    // ---- Dữ liệu riêng của từng học sinh (có trường email) ----
    // nộp / ảnh chụp bài ngoài: chỉ khi bài giao còn mở (hạn + late pass)
    match /hwdone/{id} {
      allow read: if teacher() || ownsOld();
      allow create: if ownsNew() && request.resource.data.asgId is string && asgOpen(request.resource.data.asgId);
      allow update: if ownsOld() && ownsNew() && request.resource.data.asgId == resource.data.asgId && asgOpen(resource.data.asgId);
      allow delete: if admin();
    }
    // late pass: một lần cho một bài giao (id = slug_asgId), loại day / week, khi hạn mới còn ở tương lai; không sửa được.
    // Giới hạn mỗi tháng (một 1-day, một 1-week) vẫn chỉ do app kiểm (rules không đếm được).
    match /passes/{id} {
      allow read: if teacher() || ownsOld();
      allow create: if ownsNew() && request.resource.data.asgId is string
        && id == mySlug() + '_' + request.resource.data.asgId
        && request.resource.data.kind in ['day', 'week']
        && request.time.toMillis() <= get(/databases/$(database)/documents/assignments/$(request.resource.data.asgId)).data.due
             + (request.resource.data.kind == 'week' ? 7 : 1) * 86400000;
      allow update: if admin();
      allow delete: if admin();
    }
    match /cards/{id} {
      allow read: if teacher() || ownsOld();
      allow create: if ownsNew();
      allow update: if ownsOld() && ownsNew();
      allow delete: if admin() || ownsOld();
    }
    match /redeems/{id} {
      allow read: if teacher() || ownsOld();
      allow create: if ownsNew();
      allow update, delete: if admin();
    }

    // ---- Profile: ai cũng đọc được (cần cho Leaderboard), chỉ chủ ghi ----
    // Chặn sửa tay bằng Console: mỗi lần ghi XP tăng tối đa 1000 (bằng mức XP lớn nhất chỉnh được ở Admin › XP),
    // spin / Streak Freeze / Answer Peek tăng tối đa 2. Mùa (season, seasons) và bộ đếm pity của Lucky Wheel (pity, spinTs, spinUsed) chỉ server đổi.
    // Mã voucher KHÔNG nằm trong profile nữa (inv chỉ giữ codeId; mã nằm ở codes, xem dưới). Profile cũ còn inv.code: Admin › Tools › Voucher check.
    match /profiles/{id} {
      allow read: if signedIn();
      allow create: if ownsNew()
        && numIn('xp', 0, 1000) && numIn('xpLife', 0, 1000) && numIn('spins', 0, 2) && numIn('freezes', 0, 2) && numIn('peek', 0, 2)
        && !('seasons' in request.resource.data) && !('pity' in request.resource.data);
      allow update: if ownsOld() && ownsNew()
        && numIn('xp', 0, 10000000) && numIn('spins', 0, 100000)
        && upBy('xp') <= 1000 && upBy('xpLife') <= 1000
        && upBy('spins') <= 2 && upBy('freezes') <= 2 && upBy('peek') <= 2
        && !changed().hasAny(['season', 'seasons', 'pity', 'spinTs', 'spinUsed']);
      allow delete: if admin();
    }

    // ---- Marquee "vừa quay trúng" ----
    match /wins/{id} {
      allow read: if signedIn();
      // (11/2026) chỉ server ghi (/api/spin, service account) — app không tạo dòng nào,
      // nên không ai tạo được thông báo "vừa trúng" giả từ trình duyệt
      allow create: if false;
      allow update: if false;
      allow delete: if admin();
    }

    // ---- Mã voucher (11/2026, D1a): học sinh chỉ đọc mã ĐÃ cấp cho chính mình, không tự nhận mã ----
    // Mã được cấp duy nhất bởi server khi quay trúng (/api/spin, service account). Admin thêm / xem / xóa ở Prizes.
    match /codes/{id} {
      allow read: if admin() || (signedIn() && resource.data.to == me());
      allow create, update, delete: if admin();
    }

    // ---- Sổ lỗi (Error Notebook): chỉ server tạo; học sinh chỉ sửa trạng thái ôn tập và được xóa lỗi của mình ----
    match /errors/{id} {
      allow read: if teacher() || ownsOld();
      allow create: if false;   // chỉ server tạo (service account)
      allow update: if ownsOld() && changed().hasOnly(['box','due','reviews','lapses','mastered','lastPractice']);
      allow delete: if admin() || ownsOld();
    }

    // ---- Nội dung do giáo viên / admin quản lý: mọi người đã đăng nhập đọc ----
    match /names/{id}       { allow read: if teacher(); allow write: if admin(); }
    // roster: admin ghi mọi thứ; giáo viên chỉ đổi trình độ (level) của dòng đã có
    match /roster/{id} {
      allow read: if signedIn();
      allow create, delete: if admin();
      allow update: if admin() || (teacher() && changed().hasOnly(['level']));
    }
    match /exercises/{id}   { allow read: if signedIn(); allow write: if teacher(); }
    match /assignments/{id} { allow read: if signedIn(); allow write: if teacher(); }
    match /classes/{id}     { allow read: if signedIn(); allow write: if teacher(); }
    // config: admin (XP, quà, ảnh, khung rank, tài liệu…); giáo viên chỉ mục tiêu Speaking theo bài (config/goals_<bài>)
    match /config/{id} {
      allow read: if signedIn();
      allow write: if admin() || (teacher() && id.matches('goals_.*'));
    }
  }
}
