rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function mail() { return request.auth.token.email.lower(); }
    // EDIT: put your teacher email(s) here (lowercase)
    function teacher() { return signedIn() && mail() in ['lorenkids795@gmail.com']; }
    function member() { return signedIn(); }

    match /{col}/{id} {
      allow read: if member() && col in ['roster','exercises','assignments','classes','config'];
      allow write: if teacher() && col in ['roster','exercises','assignments','classes','config'];
      allow read, write: if member() && col in ['attempts','hwdone','profiles','cards','wins','codes','redeems','passes'];
    }
  }
}
